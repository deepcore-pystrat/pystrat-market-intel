# DeepCore Postgres access — copy this file to `.env` and fill in your credentials.
# `.env` is gitignored: NEVER commit real credentials.
# Alternatively, set these as environment variables (they take lower priority than .env).

POSTGRES_HOST=
POSTGRES_DATABASE=
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
# Optional, defaults to 5432
# POSTGRES_PORT=5432

# IB Gateway (only needed for IBKR data ingestion)
IBGATEWAY_HOST=
IBGATEWAY_PORT=

# Publication (only needed with --notify / S3 uploads, at platform hookup time)
# SLACK_TOKEN=
# SLACK_CHANNEL=
# SLACK_USERNAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
